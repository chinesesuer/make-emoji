<view class="page">
  <view class="header">
    <view class="nav">
      <text class="title">更多工具</text>
      <view class="capsule"><text>•••</text><view class="divider"/><view class="circle"/></view>
    </view>
  </view>

  <scroll-view class="content" scroll-y="true">
    <view class="mixer-banner" bindtap="openMixer">
      <view class="banner-icon">⚄</view>
      <view class="banner-copy"><text class="banner-title">表情包合成器</text><text class="banner-sub">两个表情合成一个新表情 · 掷骰子随机生成</text></view>
      <text class="chevron">›</text>
    </view>
    <view class="mixer-banner diy-banner" bindtap="openDiy">
      <view class="banner-icon">☺</view>
      <view class="banner-copy"><text class="banner-title">DIY表情</text><text class="banner-sub">自由组合脸型、眼睛、嘴巴与装饰</text></view>
      <text class="chevron">›</text>
    </view>

    <view class="card">
      <view class="card-title"><text class="section-icon purple">▣</text>图片处理</view>
      <view class="grid">
        <view class="tool" data-name="一键抠图" bindtap="openTool"><view class="tool-icon violet">✦</view><text>一键抠图</text></view>
        <view class="tool" bindtap="openGridSlice"><view class="tool-icon orange">▦</view><text>九宫格切图</text></view>
        <view class="tool" bindtap="openWatermark"><view class="tool-icon watermark">▣</view><text>图片加水印</text></view>
      </view>
    </view>

    <view class="card">
      <view class="card-title"><text class="section-icon fire">♨</text>热门推荐</view>
      <view class="grid">
        <view class="tool" data-name="表情包搜索" bindtap="openTool"><view class="tool-icon yellow">⌕</view><text>表情包搜索</text></view>
        <view class="tool" data-name="每日榜单" bindtap="openTool"><view class="tool-icon rose">♛</view><text>每日榜单</text></view>
        <view class="tool" data-name="制作教程" bindtap="openTool"><view class="tool-icon blue">▤</view><text>制作教程</text></view>
        <view class="tool" data-name="意见反馈" bindtap="openTool"><view class="tool-icon gray">●</view><text>意见反馈</text></view>
      </view>
    </view>
    <view class="bottom-space"/>
  </scroll-view>

</view>
