page{background:#f1f5f9}
.page{height:100vh;display:flex;flex-direction:column;color:#334155;background:#f1f5f9}
.header{height:164rpx;background:#5b5fe9;color:#fff;flex-shrink:0;padding-top:env(safe-area-inset-top);box-sizing:border-box}
.nav{height:100%;padding:40rpx 34rpx 22rpx 40rpx;display:flex;align-items:flex-end;justify-content:space-between;box-sizing:border-box}
.title{font-size:42rpx;font-weight:800;letter-spacing:2rpx}.capsule{height:56rpx;padding:0 18rpx;display:flex;align-items:center;gap:16rpx;background:rgba(255,255,255,.2);border-radius:30rpx;font-size:25rpx}.divider{width:2rpx;height:28rpx;background:rgba(255,255,255,.35)}.circle{width:25rpx;height:25rpx;border:4rpx solid #fff;border-radius:50%}
.content{flex:1;min-height:0;box-sizing:border-box}.mixer-banner{margin:28rpx 30rpx 0;padding:28rpx 28rpx;background:linear-gradient(100deg,#5b5fe9,#818cf8);border-radius:30rpx;display:flex;align-items:center;color:#fff;box-shadow:0 12rpx 28rpx rgba(91,95,233,.24)}.banner-icon{width:88rpx;height:88rpx;border-radius:24rpx;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-size:46rpx}.banner-copy{flex:1;display:flex;flex-direction:column;margin-left:24rpx}.banner-title{font-size:30rpx;font-weight:800}.banner-sub{font-size:21rpx;color:rgba(255,255,255,.76);margin-top:8rpx}.chevron{font-size:50rpx;color:rgba(255,255,255,.75)}
.diy-banner{margin-top:18rpx;background:linear-gradient(100deg,#10b981,#34d399);box-shadow:0 12rpx 28rpx rgba(16,185,129,.22)}
.card{margin:24rpx 30rpx 0;padding:28rpx 24rpx 34rpx;background:#fff;border-radius:30rpx;box-shadow:0 4rpx 14rpx rgba(15,23,42,.04)}.card-title{display:flex;align-items:center;font-size:28rpx;font-weight:800;margin-bottom:28rpx}.section-icon{margin-right:13rpx}.purple{color:#5b5fe9}.pink{color:#ec4899}.fire{color:#f97316}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28rpx 8rpx}.tool{display:flex;flex-direction:column;align-items:center;font-size:23rpx;white-space:nowrap}.tool-icon{width:96rpx;height:96rpx;border-radius:24rpx;color:#fff;display:flex;align-items:center;justify-content:center;font-size:38rpx;margin-bottom:14rpx;box-shadow:0 8rpx 16rpx rgba(15,23,42,.12)}.green{background:#10b981}.cyan{background:#0ea5e9}.violet{background:#8b5cf6}.orange{background:#fb923c}.pink-bg{background:#ec4899}.indigo{background:#5b5fe9}.teal{background:#14b8a6}.yellow{background:#fbbf24}.rose{background:#f43f5e}.blue{background:#6366f1}.gray{background:#64748b}.bottom-space{height:36rpx}
.tabbar{height:106rpx;background:#fff;display:flex;flex-shrink:0}.tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#98a2ba;font-size:28rpx}.tab text{font-size:19rpx}.tab.active{color:#5b5fe9}
