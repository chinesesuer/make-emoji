page{background:#f1f5f9}.login-page{min-height:100vh;background:#fff;display:flex;flex-direction:column}.brand{background:linear-gradient(135deg,#5b5fe9,#6366f1);color:#fff;padding:100rpx 70rpx 65rpx;position:relative;overflow:hidden}.brand:after{content:'🐼';position:absolute;right:-30rpx;top:-40rpx;font-size:210rpx;opacity:.12}.brand-icon{width:65rpx;height:65rpx;border-radius:16rpx;background:rgba(255,255,255,.2);text-align:center;line-height:65rpx;font-size:40rpx}.brand-title{font-size:31rpx;font-weight:bold;margin-top:20rpx}.brand-slogan{font-size:52rpx;font-weight:900;line-height:1.25;margin:62rpx 0 18rpx}.brand-note,.brand-features{font-size:25rpx;line-height:1.8;color:rgba(255,255,255,.8)}.brand-features{margin-top:58rpx}.form{padding:60rpx 65rpx;display:flex;flex-direction:column}.welcome{font-size:42rpx;font-weight:800;color:#1e293b}.hint{font-size:25rpx;color:#94a3b8;margin:12rpx 0 55rpx}.label{font-size:24rpx;color:#64748b;margin-bottom:12rpx}.input{height:84rpx;background:#f8fafc;border:2rpx solid #e2e8f0;border-radius:15rpx;padding:0 24rpx;font-size:27rpx;margin-bottom:35rpx}.login-btn{background:#5b5fe9;color:#fff;border-radius:15rpx;margin-top:20rpx;font-size:29rpx;font-weight:bold}.copyright{text-align:center;color:#cbd5e1;font-size:20rpx;margin-top:55rpx}
