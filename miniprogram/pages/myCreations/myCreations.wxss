page{background:#f1f5f9}.creations-page{min-height:100vh;padding:28rpx;box-sizing:border-box}.creation-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20rpx}.creation-card{aspect-ratio:1;background:#fff;border-radius:22rpx;padding:10rpx;box-sizing:border-box;box-shadow:0 4rpx 14rpx rgba(15,23,42,.07);overflow:hidden}.creation-card image{width:100%;height:100%;border-radius:15rpx;display:block}.state-view{min-height:520rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22rpx;color:#94a3b8;font-size:28rpx}.empty-icon{width:100rpx;height:100rpx;border-radius:30rpx;background:#fff;color:#6864eb;display:flex;align-items:center;justify-content:center;font-size:66rpx;box-shadow:0 4rpx 14rpx rgba(15,23,42,.06)}.error-state{color:#64748b}.retry-text{color:#5b5fe9;background:#fff;padding:16rpx 34rpx;border-radius:30rpx}.spinner{width:48rpx;height:48rpx;border:6rpx solid #dfe3f8;border-top-color:#5b5fe9;border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
