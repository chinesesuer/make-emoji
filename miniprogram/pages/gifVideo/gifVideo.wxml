<view class="page">
  <view class="header"><view class="nav"><view class="back" bindtap="goBack">‹</view><text>视频转GIF</text><view class="capsule">•••　◯</view></view></view>
  <scroll-view class="content" scroll-y enhanced show-scrollbar="false">
    <view wx:if="{{!video}}" class="empty-wrap">
      <view class="picker" bindtap="chooseVideo">
        <view class="video-icon"><view class="play"/></view>
        <text class="picker-title">点击选择视频</text>
        <text class="picker-sub">支持MP4/MOV格式，最长10秒</text>
      </view>
    </view>
    <block wx:else>
      <view class="preview-card">
        <view class="video-wrap" style="height:364rpx;position:relative"><video class="preview" style="height:100%" src="{{video.path}}" poster="{{video.thumb}}" controls object-fit="fill"/><text class="duration" style="right:12rpx;bottom:12rpx">{{video.durationText}}</text><view wx:if="{{crop}}" class="crop-frame" style="margin:0;transform:none;left:{{crop.left}}%;top:{{crop.top}}%;width:{{crop.widthPercent}}%;height:{{crop.heightPercent}}%;"><text>{{crop.width}}x{{crop.height}}</text></view></view>
      </view>
      <view wx:if="{{crop}}" class="clear-row"><button style="display:flex;align-items:center;justify-content:center" bindtap="clearCrop">×　清除裁剪</button></view>
      <view class="card settings">
        <view class="card-head"><text class="card-title">转换设置</text><view class="segments"><view class="{{!crop ? 'active' : ''}}" bindtap="trimVideo">剪时长</view><view class="{{crop ? 'active' : ''}}" bindtap="openCrop">裁画面</view></view></view>
        <view class="line"><text>帧率（FPS）</text><view class="stepper"><view bindtap="fpsMinus">−</view><text>{{fps}}</text><view bindtap="fpsPlus">＋</view></view></view>
        <view class="line"><text>输出分辨率</text><text class="value">{{resolutions[resolutionIndex]}}</text></view>
        <slider min="0" max="3" value="{{resolutionIndex}}" step="1" activeColor="#5B5FE9" block-color="#5B5FE9" bindchange="changeResolution"/>
        <view class="line"><text>循环次数</text><view class="stepper"><view bindtap="loopMinus">−</view><text>{{loop === 0 ? '无限' : loop + ' 次'}}</text><view bindtap="loopPlus">＋</view></view></view>
      </view>
      <view class="spacer"/>
    </block>
  </scroll-view>
  <view wx:if="{{video}}" class="bottom"><button class="secondary" style="display:flex;align-items:center;justify-content:center;line-height:normal;padding:0" bindtap="changeVideo">更换视频</button><button class="primary" style="display:flex;align-items:center;justify-content:center;line-height:normal;padding:0" loading="{{converting}}" disabled="{{converting}}" bindtap="startConvert">开始转换</button></view>
  <view wx:if="{{resultVisible}}" style="position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:20;display:flex;align-items:center;justify-content:center;padding:50rpx"><view style="width:100%;background:#fff;border-radius:30rpx;padding:34rpx;box-sizing:border-box"><text style="display:block;text-align:center;font-size:32rpx;font-weight:700">GIF 已生成</text><image style="display:block;width:100%;height:520rpx;margin-top:24rpx;background:#f1f5f9;border-radius:20rpx" src="{{generatedGif}}" mode="aspectFit"/><view style="display:flex;gap:20rpx;margin-top:28rpx"><button class="secondary" style="flex:1;height:84rpx;display:flex;align-items:center;justify-content:center;line-height:normal;padding:0" bindtap="closeResult">关闭</button><button class="primary" style="flex:1;height:84rpx;display:flex;align-items:center;justify-content:center;line-height:normal;padding:0" bindtap="saveGif">保存到相册</button></view></view></view>
</view>
