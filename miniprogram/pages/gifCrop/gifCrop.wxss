page{background:#f1f5f9}.page{height:100vh;display:flex;flex-direction:column;color:#334155}.header{height:164rpx;background:#5b5fe9;color:#fff;flex-shrink:0;padding-top:env(safe-area-inset-top);box-sizing:border-box}.nav{height:100%;padding:38rpx 34rpx 22rpx;display:flex;align-items:flex-end;justify-content:space-between;box-sizing:border-box;font-size:36rpx;font-weight:700}.back{width:64rpx;height:64rpx;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:52rpx;font-weight:400}.capsule{font-size:24rpx;background:rgba(255,255,255,.2);padding:14rpx 22rpx;border-radius:32rpx}.content{flex:1;min-height:0}.stage-card,.info,.ratio-card{margin:28rpx 30rpx 0;background:#fff;border-radius:28rpx;box-shadow:0 4rpx 14rpx rgba(15,23,42,.05)}.stage-card{padding:22rpx}.stage{height:364rpx;position:relative;background:#0f172a;border-radius:20rpx;overflow:hidden}.video{width:100%;height:100%}.crop{position:absolute;box-sizing:border-box;border:4rpx solid #5b5fe9;z-index:3}.grid{position:absolute;background:rgba(255,255,255,.75)}.h1,.h2{left:0;width:100%;height:2rpx}.h1{top:33.33%}.h2{top:66.66%}.v1,.v2{top:0;height:100%;width:2rpx}.v1{left:33.33%}.v2{left:66.66%}.handle{position:absolute;width:24rpx;height:24rpx;background:#5b5fe9;border:4rpx solid #fff;border-radius:50%}.lt{left:-14rpx;top:-14rpx}.rt{right:-14rpx;top:-14rpx}.lb{left:-14rpx;bottom:-14rpx}.rb{right:-14rpx;bottom:-14rpx}.info{padding:24rpx 28rpx;font-size:27rpx;color:#64748b}.info .value{color:#5b5fe9;font-weight:600}.ratio-card{padding:30rpx}.title{font-size:30rpx;font-weight:700}.ratio-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18rpx;margin-top:22rpx}.ratio{height:72rpx;border-radius:14rpx;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-size:27rpx;color:#475569}.ratio.active{background:#5b5fe9;color:#fff;font-weight:600}.tip{display:block;margin-top:24rpx;color:#94a3b8;font-size:23rpx}.spacer{height:180rpx}.bottom{flex-shrink:0;padding:22rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));background:#fff;display:flex;gap:22rpx}.bottom button{height:92rpx;line-height:92rpx;border-radius:26rpx;font-weight:700;font-size:30rpx}.bottom button::after{border:0}.secondary{flex:1;background:#f1f5f9;color:#475569}.primary{flex:1.5;background:#5b5fe9;color:#fff}
