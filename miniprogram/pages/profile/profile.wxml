<view class="profile-page">
  <view class="profile-hero"><view class="profile-nav"><text>个人中心</text><view>•••　○</view></view></view>
  <scroll-view class="profile-content" scroll-y="true">
    <view class="user-card" bindtap="login"><view class="avatar"><image wx:if="{{loggedIn && user.avatarUrl}}" class="avatar-image" src="{{user.avatarUrl}}" mode="aspectFill"/><text wx:else>👦</text></view><view class="user-info"><view><text class="username">{{loggedIn ? user.nickName : '点击登录'}}</text><text class="user-tag">{{loggedIn ? '普通用户' : '未登录'}}</text></view><text class="uid">{{loggedIn ? '已登录微信账号' : '登录后使用全部功能'}}</text></view><text class="edit">{{loggedIn ? '查看' : '登录'}}</text></view>
    <view class="entry-card"><view class="entry" data-name="我的制作" data-action="creations" bindtap="openUserFeature"><text class="entry-icon green">▣</text><text>我的制作</text></view><view class="entry" data-name="我的收藏" bindtap="openUserFeature"><text class="entry-icon orange">▧</text><text>我的收藏</text></view><view class="entry" data-name="我的邀请" bindtap="openUserFeature"><text class="entry-icon blue">♙</text><text>我的邀请</text></view><view class="entry" data-name="免广告" bindtap="openUserFeature"><text class="entry-icon red">▻</text><text>免广告</text></view></view>
    <view class="list-card"><view class="list-row" bindtap="comingSoon"><text class="list-icon blue">☏</text><text class="row-title">联系我们</text><text class="row-sub">反馈与建议</text><text>›</text></view><view class="list-row" bindtap="comingSoon"><text class="list-icon purple">i</text><text class="row-title">关于我们</text><text class="row-sub">v6.6.11</text><text>›</text></view></view>
    <view class="thanks">感谢您的使用与支持</view>
  </scroll-view>
</view>
