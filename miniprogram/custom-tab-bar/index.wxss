:host{display:block;height:112rpx}.tabbar{height:112rpx;background:rgba(255,255,255,.98);border-top:1rpx solid #edf0f6;display:flex;padding:8rpx 2rpx 6rpx;box-sizing:border-box}.tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#98a2ba}.tab-icon{width:38rpx;height:38rpx;margin-bottom:3rpx;display:block;flex-shrink:0}.tab text{font-size:19rpx;line-height:26rpx}.tab.active{color:#5b5fe9}
