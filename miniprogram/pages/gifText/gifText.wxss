page{background:#f1f5f9}.page{height:100vh;display:flex;flex-direction:column;color:#334155}.header{height:164rpx;padding-top:env(safe-area-inset-top);box-sizing:border-box;background:#5b5fe9;color:#fff;flex-shrink:0}.nav{height:100%;padding:36rpx 34rpx 22rpx;box-sizing:border-box;display:flex;align-items:flex-end;justify-content:space-between;font-size:36rpx;font-weight:800}.back{width:64rpx;height:64rpx;border-radius:50%;background:rgba(255,255,255,.18);font-size:58rpx;line-height:55rpx;text-align:center;font-weight:400}.capsule{height:56rpx;line-height:56rpx;border-radius:30rpx;background:rgba(255,255,255,.18);padding:0 18rpx;font-size:22rpx;font-weight:400}.content{flex:1;min-height:0}.empty-wrap{padding:28rpx 30rpx}.picker{height:400rpx;border:4rpx dashed #cbd5e1;border-radius:28rpx;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center}.picker image{width:132rpx;height:132rpx;padding:24rpx;border-radius:30rpx;background:#5b5fe9}.picker-title{font-size:34rpx;font-weight:800;margin-top:28rpx}.picker-sub{font-size:24rpx;color:#94a3b8;margin-top:12rpx}.preview-card,.card{margin:28rpx 30rpx 0;padding:20rpx;background:#fff;border-radius:28rpx;box-shadow:0 4rpx 14rpx rgba(15,23,42,.05)}.stage{width:100%;position:relative;overflow:hidden;border-radius:20rpx;background:#0f172a}.gif{position:absolute;width:100%;height:100%}.text-box{width:360rpx;height:auto;min-height:70rpx;color:#fff;overflow:visible}.text-box text{white-space:pre-wrap;word-break:break-all}.delete{position:absolute;left:-28rpx;top:-30rpx;width:46rpx;height:46rpx;border-radius:50%;background:#ef4444;color:#fff;text-align:center;line-height:42rpx;font-size:36rpx}.resize{position:absolute;right:-18rpx;bottom:-20rpx;width:42rpx;height:42rpx;border-radius:50%;background:#5b5fe9;color:#fff;text-align:center;line-height:42rpx}.preview-tip{display:block;text-align:center;color:#94a3b8;font-size:22rpx;margin-top:16rpx}.card{padding:30rpx}.title{font-size:29rpx;font-weight:800}.section{display:block;margin-top:34rpx}.text-input{width:100%;min-height:80rpx;margin-top:18rpx;padding:20rpx;background:#f1f5f9;border-radius:16rpx;box-sizing:border-box;font-size:28rpx}.swatches{display:flex;flex-wrap:wrap;gap:15rpx;margin-top:20rpx}.swatch{width:68rpx;height:68rpx;border-radius:20rpx;box-sizing:border-box;border:2rpx solid #e2e8f0;color:#fff;text-align:center;line-height:64rpx;text-shadow:0 1rpx 3rpx #000}.swatch.chosen{box-shadow:0 0 0 5rpx rgba(91,95,233,.35)}.chips{display:flex;gap:20rpx;margin-top:18rpx}.chip{padding:18rpx 46rpx;border-radius:16rpx;background:#f1f5f9;color:#64748b}.chip.active{background:#eef0fe;color:#5b5fe9;box-shadow:inset 0 0 0 2rpx rgba(91,95,233,.3)}.range-head{display:flex;justify-content:space-between;color:#64748b;font-size:26rpx;margin-top:34rpx}.spacer{height:150rpx}.bottom{padding:22rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));background:#fff;flex-shrink:0}.bottom button{height:92rpx;line-height:92rpx;padding:0;border:0;border-radius:24rpx;font-size:29rpx;font-weight:800}.bottom button::after{border:0}.disabled{width:100%;color:#94a3b8!important;background:#e2e8f0!important}.actions{display:flex;gap:20rpx}.secondary{flex:1;background:#f1f5f9;color:#64748b}.primary{flex:1.5;background:#5b5fe9!important;color:#fff!important}.export-canvas{position:fixed;left:-3000px;top:-3000px;width:480px;height:480px}.result-mask{position:fixed;inset:0;z-index:100;background:rgba(8,15,39,.86);display:flex;align-items:center;justify-content:center}.result-panel{width:610rpx;padding:34rpx 30rpx 28rpx;background:#fff;border-radius:30rpx;display:flex;flex-direction:column;align-items:center}.result-title{font-size:34rpx;font-weight:800;margin-bottom:26rpx}.result-image{width:540rpx;height:540rpx;background:#f1f5f9}.save-button{width:420rpx;margin-top:30rpx;background:#5b5fe9!important;color:#fff!important}.result-close{margin-top:22rpx;color:#94a3b8;font-size:48rpx}
