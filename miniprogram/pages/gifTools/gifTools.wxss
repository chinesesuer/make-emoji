page{background:#f1f5f9}
.gif-page{height:100vh;display:flex;flex-direction:column;color:#334155;background:#f1f5f9}
.gif-header{height:164rpx;background:#5b5fe9;color:#fff;flex-shrink:0;padding-top:env(safe-area-inset-top);box-sizing:border-box}
.gif-nav{height:100%;padding:40rpx 34rpx 22rpx 40rpx;display:flex;align-items:flex-end;justify-content:space-between;box-sizing:border-box}
.gif-title{font-size:42rpx;font-weight:800;letter-spacing:2rpx}
.nav-capsule{height:56rpx;padding:0 18rpx;display:flex;align-items:center;gap:16rpx;background:rgba(255,255,255,.2);border-radius:30rpx;font-size:25rpx}
.nav-divider{width:2rpx;height:28rpx;background:rgba(255,255,255,.35)}
.nav-circle{width:25rpx;height:25rpx;border:4rpx solid #fff;border-radius:50%}
.gif-content{flex:1;min-height:0;padding-bottom:106rpx;box-sizing:border-box}
.tools-card{margin:28rpx 30rpx 0;padding:34rpx 20rpx 42rpx;background:#fff;border-radius:28rpx;box-shadow:0 4rpx 14rpx rgba(15,23,42,.05)}
.tools-grid{display:grid;grid-template-columns:repeat(4,1fr);row-gap:38rpx;column-gap:8rpx}
.tool-item{min-width:0;display:flex;flex-direction:column;align-items:center;color:#334155;font-size:23rpx}
.tool-icon-box{width:92rpx;height:92rpx;margin-bottom:14rpx;border-radius:24rpx;background:#5b5fe9;display:flex;align-items:center;justify-content:center;box-shadow:0 9rpx 18rpx rgba(91,95,233,.25)}
.tool-icon-box image{width:42rpx;height:42rpx}
.tool-item text{white-space:nowrap}
.gif-tabbar{height:106rpx;background:#fff;display:flex;flex-shrink:0}
.gif-tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#98a2ba;font-size:28rpx}
.gif-tab text{font-size:19rpx}
.gif-tab.active{color:#5b5fe9}
