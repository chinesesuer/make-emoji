<view class="page">
  <view class="header"><view class="nav"><view class="back" bindtap="cancel">‹</view><text>裁剪画面</text><view class="capsule">•••　◯</view></view></view>
  <scroll-view class="content" scroll-y enhanced show-scrollbar="false">
    <view class="stage-card">
      <view id="stage" class="stage">
        <video src="{{path}}" class="video" controls object-fit="fill"/>
        <view class="crop" style="{{cropStyle}}" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd">
          <view class="grid h1"/><view class="grid h2"/><view class="grid v1"/><view class="grid v2"/>
          <view class="handle lt"/><view class="handle rt"/><view class="handle lb"/><view class="handle rb"/>
        </view>
      </view>
    </view>
    <view class="info"><text>裁剪：</text><text class="value">{{cropText}}</text></view>
    <view class="ratio-card">
      <text class="title">裁剪比例</text>
      <view class="ratio-grid"><view wx:for="{{ratios}}" wx:key="value" class="ratio {{ratio === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="chooseRatio">{{item.label}}</view></view>
      <text class="tip">☝ 拖动方框可移动裁剪区域</text>
    </view>
    <view class="spacer"/>
  </scroll-view>
  <view class="bottom"><button class="secondary" style="display:flex;align-items:center;justify-content:center;line-height:normal;padding:0" bindtap="cancel">取消裁剪</button><button class="primary" style="display:flex;align-items:center;justify-content:center;line-height:normal;padding:0" bindtap="confirm">确认裁剪</button></view>
</view>
