page{background:#f1f5f9}.page{height:100vh;display:flex;flex-direction:column;color:#334155}.header{height:164rpx;padding-top:env(safe-area-inset-top);box-sizing:border-box;background:#5b5fe9;color:#fff;flex-shrink:0}.nav{height:100%;padding:36rpx 34rpx 22rpx;box-sizing:border-box;display:flex;align-items:flex-end;justify-content:space-between;font-size:36rpx;font-weight:800}.back{width:64rpx;height:64rpx;border-radius:50%;background:rgba(255,255,255,.18);font-size:58rpx;line-height:55rpx;text-align:center;font-weight:400}.capsule{height:56rpx;line-height:56rpx;border-radius:30rpx;background:rgba(255,255,255,.18);padding:0 18rpx;font-size:22rpx;font-weight:400}.content{flex:1;min-height:0}.empty-wrap{padding:28rpx 30rpx}.picker{height:400rpx;border:4rpx dashed #cbd5e1;border-radius:28rpx;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center}.picker image{width:132rpx;height:132rpx;padding:24rpx;border-radius:30rpx;background:#5b5fe9}.picker-title{font-size:34rpx;font-weight:800;margin-top:28rpx}.picker-sub{font-size:25rpx;color:#94a3b8;margin-top:12rpx}.tip{margin-top:24rpx;padding:26rpx;background:rgba(255,255,255,.7);border-radius:24rpx;color:#64748b;font-size:24rpx;line-height:1.7}.preview-card{height:390rpx;margin:28rpx 30rpx 0;padding:14rpx;background:#fff;border-radius:28rpx;box-sizing:border-box;position:relative;box-shadow:0 4rpx 14rpx rgba(15,23,42,.05);overflow:hidden}.preview{width:100%;height:100%;background:#eef2f7;border-radius:20rpx}.preview-badge{position:absolute;right:28rpx;bottom:26rpx;color:#fff;background:rgba(15,23,42,.55);border-radius:20rpx;padding:7rpx 16rpx;font-size:22rpx}.crop-badge{position:absolute;left:28rpx;bottom:26rpx;color:#fff;background:rgba(91,95,233,.82);border-radius:20rpx;padding:7rpx 16rpx;font-size:22rpx}.card{margin:24rpx 30rpx 0;padding:28rpx;background:#fff;border-radius:28rpx;box-shadow:0 4rpx 14rpx rgba(15,23,42,.05)}.card-head{display:flex;align-items:center;justify-content:space-between}.card-title{font-size:29rpx;font-weight:800}.muted{color:#94a3b8;font-size:21rpx}.add,.value{color:#5b5fe9;font-size:25rpx;font-weight:700}.thumb-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18rpx;margin-top:24rpx}.thumb{height:130rpx;border-radius:18rpx;overflow:hidden;position:relative;background:#e2e8f0;transition:transform .15s}.thumb.dragging{transform:scale(1.08);opacity:.75;z-index:2}.thumb image{width:100%;height:100%}.remove{position:absolute;right:7rpx;top:7rpx;width:36rpx;height:36rpx;border-radius:50%;background:#f05252;color:#fff;line-height:32rpx;text-align:center;font-size:30rpx}.number{position:absolute;left:7rpx;bottom:7rpx;min-width:31rpx;height:31rpx;padding:0 5rpx;border-radius:8rpx;background:rgba(0,0,0,.5);color:#fff;text-align:center;line-height:31rpx;font-size:19rpx}.settings{padding-bottom:34rpx}.setting-line{display:flex;justify-content:space-between;align-items:center;margin-top:34rpx;color:#64748b;font-size:26rpx}.settings slider{margin:18rpx 0 18rpx}.setting-label{display:block;color:#64748b;font-size:26rpx;margin:25rpx 0 18rpx}.segments{display:flex;gap:12rpx}.segments view{flex:1;height:66rpx;line-height:66rpx;text-align:center;background:#f1f5f9;border-radius:15rpx;color:#64748b;font-size:24rpx}.segments .active{color:#5b5fe9;background:#e9eafd;font-weight:800;box-shadow:inset 0 0 0 2rpx rgba(91,95,233,.25)}.loop-line{margin-top:34rpx}.stepper{display:flex;align-items:center;gap:20rpx}.stepper view{width:58rpx;height:58rpx;line-height:56rpx;text-align:center;background:#f1f5f9;border-radius:14rpx;font-size:30rpx}.stepper text{width:80rpx;text-align:center;color:#334155;font-size:24rpx}.estimate{display:block;text-align:center;color:#94a3b8;font-size:22rpx;margin:24rpx}.scroll-spacer{height:160rpx}.bottom-bar{padding:24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));background:#fff;flex-shrink:0}.bottom-bar button{height:92rpx;line-height:92rpx;padding:0;border:0;border-radius:24rpx;font-size:29rpx;font-weight:800}.bottom-bar button::after{border:0}.disabled{color:#94a3b8!important;background:#e2e8f0!important}.actions{display:flex;gap:20rpx}.secondary{flex:1;background:#f1f5f9;color:#64748b}.primary{flex:1.5;background:#5b5fe9!important;color:#fff!important}.export-canvas{position:fixed;left:-2000px;top:-2000px;width:480px;height:480px}.result-mask{position:fixed;inset:0;z-index:100;background:rgba(8,15,39,.86);display:flex;align-items:center;justify-content:center}.result-panel{width:610rpx;padding:34rpx 30rpx 28rpx;background:#fff;border-radius:30rpx;display:flex;flex-direction:column;align-items:center;box-sizing:border-box}.result-title{font-size:34rpx;font-weight:800;margin-bottom:26rpx}.result-image{width:540rpx;height:540rpx;background:#f1f5f9;border-radius:18rpx}.save-button{width:420rpx;margin-top:30rpx;background:#5b5fe9!important;color:#fff!important;font-size:29rpx;font-weight:800}.save-button::after{border:0}.result-close{margin-top:22rpx;color:#94a3b8;font-size:48rpx;line-height:1}
