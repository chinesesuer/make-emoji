page{background:#fff}.page{height:100vh;display:flex;flex-direction:column;background:#fff;color:#111}.header{height:164rpx;background:#24272e;color:#fff;flex-shrink:0;padding-top:env(safe-area-inset-top);box-sizing:border-box}.nav{height:100%;padding:40rpx 14rpx 22rpx 26rpx;display:flex;align-items:flex-end;justify-content:space-between;box-sizing:border-box}.back{width:64rpx;height:64rpx;border-radius:50%;background:rgba(255,255,255,.06);display:flex;align-items:center;justify-content:center;font-size:50rpx}.title{font-size:31rpx;font-weight:500}.capsule{height:58rpx;padding:0 18rpx;display:flex;align-items:center;gap:16rpx;border:1rpx solid rgba(255,255,255,.13);border-radius:32rpx;font-size:25rpx}.divider{width:2rpx;height:30rpx;background:rgba(255,255,255,.18)}.circle{width:25rpx;height:25rpx;border:5rpx solid #fff;border-radius:50%}
.content{flex:1;min-height:0;display:flex;flex-direction:column}.preview{height:360rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.composition{width:330rpx;height:330rpx;position:relative;display:flex;align-items:center;justify-content:center}.face-image{position:absolute;inset:0;width:100%;height:100%}.face-glyph{font-size:300rpx;line-height:1}.eyes-layer,.pupil-layer,.mouth-layer,.deco-layer{position:absolute;left:50%;transform:translateX(-50%);z-index:2;white-space:pre}.eyes-layer{top:105rpx;width:176rpx;height:58rpx;display:flex;align-items:center;justify-content:space-between}.eye{width:58rpx;height:58rpx}.eye-right{transform:scaleX(-1)}.pupil-layer{top:112rpx;color:#111;font-size:32rpx;letter-spacing:28rpx;z-index:3}.mouth-layer{top:190rpx;color:#855511;font-size:67rpx;font-weight:800}.deco-layer{font-size:72rpx;z-index:4}.deco-0{top:-18rpx}.deco-1{top:12rpx;left:18%;transform:none}.deco-2{top:16rpx;left:auto;right:10%;transform:none}.deco-3{top:92rpx;left:2%;transform:none}.deco-4{top:92rpx;left:auto;right:-2%;transform:none}.deco-5{top:230rpx}.deco-6{top:226rpx;left:6%;transform:none}.deco-7{top:226rpx;left:auto;right:2%;transform:none}
.face-loading{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#98a2b3;font-size:22rpx}.loading-spinner{width:46rpx;height:46rpx;border:5rpx solid #e5e7eb;border-top-color:#4d79ee;border-radius:50%;margin-bottom:16rpx;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.material-scroll{height:410rpx;flex-shrink:0}.material-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:8rpx;padding:8rpx 16rpx 18rpx}.material-item{height:74rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box}.material-item.selected{background:#eef2ff;border:3rpx solid #4d79ee}.material-glyph{font-size:48rpx;line-height:1}.material-image{width:64rpx;height:64rpx}.thumb-loading{width:52rpx;height:52rpx;border-radius:50%;background:#eef0f3}.feature-glyph{font-size:35rpx;color:#855511;font-weight:700}.hint{text-align:center;color:#667085;font-size:30rpx;margin:12rpx 20rpx 22rpx}.categories,.actions{display:flex;gap:20rpx;padding:0 10rpx;flex-shrink:0}.category{height:80rpx;flex:1;border:1rpx solid #d8dbe1;border-radius:9rpx;display:flex;align-items:center;justify-content:center;font-size:30rpx;background:#fafafa}.category.active{color:#fff;background:#4d79ee;border-color:#4d79ee}.actions{margin-top:20rpx;padding:0 28rpx;justify-content:space-between}.action{width:130rpx;height:80rpx;line-height:78rpx;padding:0;margin:0;border:1rpx solid #d8dbe1;border-radius:9rpx;background:#fafafa;font-size:29rpx}.action.accent{color:#ff382d}.action.disabled{opacity:.4}.action::after{border:0}
.tabbar{height:106rpx;border-top:1rpx solid #eee;background:#fff;display:flex;flex-shrink:0}.tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#111;font-size:38rpx}.tab text{font-size:20rpx;margin-top:1rpx}.tab.active{color:#22c55e}.export-canvas{position:fixed;left:-1000px;top:-1000px;width:640px;height:640px;pointer-events:none}
.mouth-layer{top:178rpx;width:126rpx;height:92rpx;color:initial;font-size:initial;font-weight:initial}
