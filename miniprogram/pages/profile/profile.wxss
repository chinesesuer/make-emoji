page{background:#f1f5f9}.profile-page{height:100vh;display:flex;flex-direction:column;color:#334155}.profile-hero{height:156rpx;background:#5b5fe9;color:#fff;flex-shrink:0}.profile-nav{padding:60rpx 40rpx 0;display:flex;justify-content:space-between;align-items:center;font-size:42rpx;font-weight:800}.profile-nav view{font-size:25rpx;font-weight:normal;background:rgba(255,255,255,.18);padding:10rpx 18rpx;border-radius:30rpx}.profile-content{flex:1;padding-bottom:120rpx;box-sizing:border-box}.user-card,.entry-card,.list-card{background:#fff;border-radius:22rpx;margin:28rpx 30rpx 0;box-shadow:0 3rpx 10rpx rgba(15,23,42,.04)}.user-card{padding:28rpx;display:flex;align-items:center;gap:22rpx}.avatar{width:110rpx;height:110rpx;border-radius:22rpx;background:#e0f2fe;font-size:63rpx;display:flex;justify-content:center;align-items:center}.user-info{flex:1}.username{font-size:31rpx;font-weight:800;margin-right:14rpx}.user-tag{font-size:19rpx;color:#64748b;background:#f1f5f9;border-radius:7rpx;padding:4rpx 10rpx}.uid{display:block;font-size:22rpx;color:#94a3b8;margin-top:10rpx}.edit{font-size:25rpx}.entry-card{padding:30rpx 8rpx;display:flex}.entry{width:25%;text-align:center;font-size:23rpx}.entry-icon{width:76rpx;height:76rpx;margin:0 auto 14rpx;display:flex;justify-content:center;align-items:center;border-radius:20rpx;color:#fff;font-size:38rpx;box-shadow:0 6rpx 12rpx rgba(0,0,0,.12)}.green{background:#22c55e}.orange{background:#fb923c}.blue{background:#3b82f6}.red{background:#f43f5e}.list-card{overflow:hidden}.list-row{height:105rpx;padding:0 28rpx;display:flex;align-items:center;gap:18rpx;border-bottom:2rpx solid #f1f5f9;font-size:28rpx}.list-row:last-child{border:0}.list-icon{width:58rpx;height:58rpx;border-radius:14rpx;color:#fff;display:flex;align-items:center;justify-content:center}.purple{background:#7c3aed}.row-title{flex:1;font-weight:600}.row-sub{font-size:22rpx;color:#94a3b8}.thanks{text-align:center;color:#94a3b8;font-size:22rpx;margin:60rpx}.profile-tabbar{height:106rpx;background:#fff;border-top:2rpx solid #f1f5f9;display:flex;flex-shrink:0;padding-bottom:env(safe-area-inset-bottom)}.profile-tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#94a3b8;font-size:30rpx}.profile-tab text{font-size:19rpx;margin-top:4rpx}.profile-tab.active{color:#5b5fe9}
