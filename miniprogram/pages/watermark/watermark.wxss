page{background:#fff}.page{height:100vh;display:flex;flex-direction:column;background:#fff;color:#2f3440}.header{height:164rpx;padding-top:env(safe-area-inset-top);box-sizing:border-box;background:#9aa8ca;flex-shrink:0}.nav{height:100%;padding:36rpx 18rpx 22rpx;box-sizing:border-box;display:flex;align-items:flex-end;justify-content:space-between}.back{width:66rpx;height:66rpx;display:flex;align-items:center;justify-content:center;font-size:52rpx}.title{font-size:32rpx;font-weight:800}.capsule{height:52rpx;padding:0 16rpx;display:flex;align-items:center;gap:14rpx;border:1rpx solid rgba(47,52,64,.18);border-radius:28rpx;font-size:23rpx}.divider{width:2rpx;height:25rpx;background:rgba(47,52,64,.24)}.circle{width:22rpx;height:22rpx;border:4rpx solid #2f3440;border-radius:50%}.preview-area{flex:1;min-height:300rpx;background:#101010;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden}.preview-canvas{display:block;border-radius:14rpx;max-width:calc(100vw - 48rpx);box-shadow:0 8rpx 28rpx rgba(0,0,0,.3)}.preview-hint{color:rgba(255,255,255,.58);font-size:22rpx;margin-top:16rpx}.empty-preview{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff}.empty-icon{width:100rpx;height:100rpx;border-radius:28rpx;background:#313131;text-align:center;line-height:100rpx;font-size:52rpx;color:#c8c8c8}.empty-title{font-size:30rpx;font-weight:700;margin-top:24rpx}.empty-tip{font-size:22rpx;color:#a3a3a3;margin:12rpx 28rpx 0;text-align:center}.choose-inline{width:218rpx;height:68rpx;margin:28rpx 0 0;background:#59bc73;color:#fff;border-radius:34rpx;font-size:26rpx}.choose-inline::after{border:0}.tool-tabs{height:84rpx;display:flex;align-items:stretch;background:#f4f4f5;flex-shrink:0}.pick-tab{width:86rpx;line-height:84rpx;text-align:center;color:#69707d;font-size:36rpx}.tab{flex:1;display:flex;align-items:center;justify-content:center;font-size:25rpx;color:#777b85}.tab.active{background:#fff;color:#2f3440;font-weight:700}.panel{height:212rpx;flex-shrink:0;background:#fff}.panel-inner{height:100%;padding:18rpx 32rpx;box-sizing:border-box}.warning{display:block;text-align:center;color:#e9513f;font-size:22rpx;font-weight:700;margin-bottom:12rpx}.text-line{display:flex;gap:14rpx}.text-line input{flex:1;height:68rpx;padding:0 18rpx;box-sizing:border-box;border:2rpx solid #d7d9df;border-radius:12rpx;font-size:27rpx}.text-line button{width:106rpx;height:68rpx;margin:0;background:#59bc73;color:#fff;border-radius:12rpx;font-size:26rpx}.text-line button::after{border:0}.slider-row{height:68rpx;display:flex;align-items:center;gap:12rpx;font-size:24rpx;color:#3d414a}.slider-row text:first-child{width:126rpx}.slider-row slider{flex:1;margin:0}.slider-row text:last-child{width:62rpx;text-align:right;color:#69707d}.swatches{height:72rpx;display:flex;align-items:center;justify-content:space-between}.swatch{width:48rpx;height:48rpx;box-sizing:border-box;border-radius:50%;border:1rpx solid rgba(0,0,0,.14);color:#fff;text-align:center;line-height:48rpx;font-size:25rpx;text-shadow:0 1rpx 3rpx rgba(0,0,0,.45)}.swatch.light{color:#444;text-shadow:none}.swatch.selected{box-shadow:0 0 0 4rpx #fff,0 0 0 7rpx #747985}.centered{padding-top:50rpx}.helper{display:block;color:#a2a5ac;font-size:22rpx;text-align:center;margin-top:10rpx}.bottom{display:flex;gap:18rpx;padding:18rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #f0f0f0;flex-shrink:0}.bottom button{height:80rpx;margin:0;border-radius:18rpx;font-size:28rpx;font-weight:700}.bottom button::after{border:0}.choose-inline,.text-line button,.bottom button{display:flex;align-items:center;justify-content:center;padding:0;text-align:center}.secondary{flex:1;background:#eef0f2;color:#59606a}.primary{flex:1.35;background:#59bc73;color:#fff}.primary[disabled]{background:#c5d8cb;color:#fff}.export-canvas{position:fixed;left:-3000px;top:-3000px;width:10px;height:10px;pointer-events:none}
