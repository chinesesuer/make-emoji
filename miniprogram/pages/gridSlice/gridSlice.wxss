page{background:#fcfcfc}.page{height:100vh;display:flex;flex-direction:column;color:#1e293b;background:#fcfcfc}.header{height:164rpx;background:#fcfcfc;flex-shrink:0;padding-top:env(safe-area-inset-top);box-sizing:border-box}.nav{height:100%;padding:38rpx 18rpx 22rpx;display:flex;align-items:flex-end;justify-content:space-between;box-sizing:border-box}.back{width:66rpx;height:66rpx;display:flex;align-items:center;justify-content:center;font-size:50rpx}.title{font-size:33rpx;font-weight:800}.capsule{height:56rpx;padding:0 18rpx;display:flex;align-items:center;gap:15rpx;border:1rpx solid rgba(0,0,0,.12);border-radius:30rpx;font-size:24rpx}.divider{width:2rpx;height:28rpx;background:rgba(0,0,0,.15)}.circle{width:24rpx;height:24rpx;border:4rpx solid #334155;border-radius:50%}
.content{flex:1;min-height:0}.paper{background-color:#fcfcfc;background-image:linear-gradient(rgba(20,28,60,.045) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(20,28,60,.045) 1rpx,transparent 1rpx);background-size:32rpx 32rpx}.preview-card{background:#fff;padding:18rpx 0 28rpx}.drag-tip{display:block;text-align:center;color:#a0a8b8;font-size:23rpx;margin-bottom:14rpx}.canvas-wrap{display:flex;justify-content:center}.preview-canvas{display:block;box-shadow:0 12rpx 32rpx rgba(30,40,80,.13)}
.shape-row{display:flex;align-items:center;padding:24rpx 22rpx 0;gap:8rpx}.shape-scroll{flex:1;min-width:0;white-space:nowrap}.shape-list,.grid-list{display:flex;align-items:center;gap:14rpx}.shape-chip{width:100rpx;height:100rpx;border:4rpx solid transparent;border-radius:16rpx;background:#fff;display:flex;align-items:center;justify-content:center;box-sizing:border-box;color:#f2b0b0;font-size:64rpx}.shape-chip.active{border-color:#d89c36;background:#fffdf8}.more{width:76rpx;display:flex;flex-direction:column;align-items:center;color:#475569;font-weight:700;font-size:23rpx;line-height:1.25}.grid-scroll{white-space:nowrap;margin-top:24rpx}.grid-list{padding:0 22rpx;justify-content:space-between}.grid-chip{width:96rpx;height:96rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.5)}.mini-grid{display:grid;gap:5rpx;width:62rpx;max-height:62rpx;aspect-ratio:1}.mini-cell{min-width:0;min-height:0;border-radius:2rpx;background:#dedede}.grid-chip.active .mini-cell{background:#f2b0b0}.notice{display:block;text-align:center;color:#e44e66;font-size:23rpx;font-weight:700;margin:28rpx 24rpx 0}.content-space{height:260rpx}
.actions{position:fixed;left:0;right:0;bottom:106rpx;padding:16rpx 36rpx 22rpx;display:flex;gap:22rpx;background:linear-gradient(180deg,rgba(252,252,252,0),#fcfcfc 28%);z-index:10}.pill{flex:1;height:88rpx;line-height:88rpx;border-radius:48rpx;color:#fff;font-size:28rpx;font-weight:700;margin:0;padding:0;box-shadow:0 10rpx 24rpx rgba(15,23,42,.12)}.pill::after{border:0}.choose{background:linear-gradient(90deg,#8abaf6,#aeb4f6)}.save{background:linear-gradient(90deg,#e47296,#f19ab5)}.tabbar{height:106rpx;background:rgba(255,255,255,.96);display:flex;flex-shrink:0;border-top:1rpx solid #f1f5f9;z-index:11}.tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#98a2ba;font-size:28rpx}.tab text{font-size:19rpx}.tab.active{color:#5b5fe9}
.mask{position:fixed;inset:0;background:rgba(0,0,0,.54);z-index:30}.drawer,.result{position:absolute;left:0;right:0;bottom:0;background:#fff;border-radius:36rpx 36rpx 0 0;max-height:74vh;display:flex;flex-direction:column}.drawer-head,.result-head{height:92rpx;padding:0 30rpx 0 36rpx;display:flex;align-items:center;justify-content:space-between;font-size:29rpx;font-weight:800;border-bottom:1rpx solid #f1f5f9;flex-shrink:0}.close{width:58rpx;height:58rpx;border-radius:50%;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-size:38rpx;color:#64748b}.drawer-scroll,.result-scroll{flex:1;min-height:0}.template-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22rpx;padding:22rpx 22rpx 40rpx}.template{padding:10rpx;border:5rpx solid transparent;border-radius:22rpx;text-align:center;color:#8a8a8e;font-size:21rpx}.template.active{border-color:#d89c36}.template-icon{height:112rpx;display:flex;align-items:center;justify-content:center;background:#fff7f7;color:#f2b0b0;border-radius:16rpx;font-size:70rpx;margin-bottom:6rpx}.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:18rpx;padding:24rpx}.tile{position:relative;aspect-ratio:1;background:#f1f5f9;border-radius:16rpx;overflow:hidden;border:1rpx solid #e2e8f0}.tile image{width:100%;height:100%}.tile text{position:absolute;right:8rpx;bottom:8rpx;width:34rpx;height:34rpx;border-radius:50%;background:rgba(15,23,42,.7);color:#fff;text-align:center;line-height:34rpx;font-size:19rpx}.result-foot{padding:18rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));border-top:1rpx solid #f1f5f9}.result-foot button{height:82rpx;line-height:82rpx;background:#5b5fe9;color:#fff;border-radius:20rpx;font-size:27rpx;font-weight:700}.result-foot button::after{border:0}.export-canvas{position:fixed;left:-2000px;top:-2000px;width:10px;height:10px;pointer-events:none}
.shape-mask{width:78rpx;height:78rpx}.template-icon image{width:96rpx;height:96rpx}
