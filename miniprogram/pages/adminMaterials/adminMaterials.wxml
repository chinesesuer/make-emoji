<view class="admin-page"><view class="header"><view><text class="header-title">素材管理</text><text class="crumb">首页 / 素材管理</text></view><view class="user" bindtap="logout">管 <text>{{adminName}} · 退出</text></view></view><view class="scene-tabs"><view wx:for="{{scenes}}" wx:key="key" class="scene {{scene === item.key ? 'scene-active' : ''}}" data-scene="{{item.key}}" bindtap="switchScene">{{item.label}}</view></view><view class="toolbar"><view class="toolbar-info">管理小程序「{{scene === 'body' ? '选身体' : scene === 'face' ? '选表情' : '选挂件'}}」素材</view><button class="upload-btn" bindtap="openUpload">＋ 上传素材</button></view><scroll-view class="material-list" scroll-y="true"><view class="empty" wx:if="{{!list.length}}">暂无素材，点击右上角上传第一张素材</view><view class="grid"><view class="material-card" wx:for="{{list}}" wx:key="_id"><image class="thumb" src="{{item.fileUrl}}" mode="aspectFit"/><view class="mat-name">{{item.name}}</view><view class="mat-meta"><text>{{item.categoryName}}</text><text>{{item.fileType}}</text></view><view class="delete" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="remove">删除</view></view></view></scroll-view><view wx:if="{{showUpload}}" class="mask"><view class="modal"><view class="modal-title">批量上传素材（最多 9 张）<text bindtap="closeUpload">×</text></view><view class="picker" bindtap="chooseImage"><view wx:if="{{selectedFiles.length}}" class="preview-grid"><image wx:for="{{selectedFiles}}" wx:key="path" src="{{item.path}}" mode="aspectFill"/><view class="preview-count">已选择 {{selectedFiles.length}} / 9 张</view></view><view wx:else>☁<text>点击选择图片</text><text class="minor">一次最多 9 张，支持 PNG / GIF / WebP</text></view></view><text class="field-label">所属分类 *</text><input class="field" value="{{categoryName}}" data-field="categoryName" bindinput="input" placeholder="例如：熊猫、搞笑、帽子"/><text class="field-label">起始排序值</text><input class="field" type="number" value="{{sort}}" data-field="sort" bindinput="input"/><text class="upload-note">素材名称自动使用图片文件名；排序值按选择顺序递增。</text><view class="modal-actions"><button bindtap="closeUpload">取消</button><button class="confirm" loading="{{uploading}}" bindtap="upload">上传 {{selectedFiles.length || ''}} 张素材</button></view></view></view></view>
