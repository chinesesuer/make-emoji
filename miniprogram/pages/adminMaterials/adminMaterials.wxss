page{background:#f1f5f9}.admin-page{height:100vh;display:flex;flex-direction:column;color:#1e293b}.header{height:112rpx;background:#1e2239;color:#fff;padding:0 30rpx;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}.header-title{font-size:31rpx;font-weight:bold;display:block}.crumb{font-size:19rpx;color:#94a3b8}.user{font-size:27rpx;color:#fff}.user text{font-size:20rpx;margin-left:9rpx}.scene-tabs{height:84rpx;background:#fff;display:flex;padding:0 25rpx;flex-shrink:0}.scene{font-size:27rpx;padding:26rpx 24rpx 18rpx;color:#64748b;border-bottom:5rpx solid transparent}.scene-active{color:#5b5fe9;font-weight:bold;border-color:#5b5fe9}.toolbar{background:#fff;padding:20rpx 30rpx;border-top:2rpx solid #f1f5f9;display:flex;align-items:center;justify-content:space-between}.toolbar-info{font-size:22rpx;color:#94a3b8}.upload-btn{margin:0;background:#5b5fe9;color:#fff;border-radius:12rpx;font-size:24rpx;padding:0 22rpx}.material-list{flex:1;padding:25rpx 30rpx;box-sizing:border-box}.grid{display:flex;flex-wrap:wrap;justify-content:flex-start;column-gap:3.8%;row-gap:20rpx}.material-card{width:30.8%;box-sizing:border-box;background:#fff;border-radius:18rpx;padding:12rpx;box-shadow:0 3rpx 9rpx rgba(15,23,42,.05)}.thumb{width:100%;height:130rpx;background:#f8fafc;border-radius:12rpx}.mat-name{font-size:22rpx;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:11rpx 0 7rpx}.mat-meta{color:#94a3b8;font-size:18rpx;display:flex;justify-content:space-between;white-space:nowrap;overflow:hidden}.delete{display:block;box-sizing:border-box;width:100%;min-width:0!important;padding:0!important;font-size:19rpx;color:#ef4444;background:#fff1f2;border-radius:8rpx;margin-top:10rpx;line-height:44rpx}.empty{text-align:center;color:#94a3b8;font-size:25rpx;padding-top:180rpx}.mask{position:fixed;inset:0;background:rgba(15,23,42,.48);display:flex;align-items:center;justify-content:center;z-index:10}.modal{width:610rpx;background:#fff;border-radius:22rpx;padding:0 34rpx 28rpx}.modal-title{font-size:30rpx;font-weight:bold;padding:28rpx 0}.modal-title text{float:right;font-size:42rpx;color:#94a3b8;font-weight:normal}.picker{height:235rpx;border:3rpx dashed #cbd5e1;border-radius:15rpx;display:flex;align-items:center;justify-content:center;text-align:center;font-size:45rpx;color:#94a3b8;overflow:hidden}.picker image{width:100%;height:100%}.picker text{display:block;font-size:25rpx;margin-top:8rpx}.picker .minor{font-size:19rpx;color:#cbd5e1}.field-label{display:block;color:#64748b;font-size:22rpx;margin:20rpx 0 8rpx}.field{height:70rpx;border:2rpx solid #e2e8f0;border-radius:10rpx;padding:0 18rpx;font-size:24rpx}.modal-actions{display:flex;gap:18rpx;justify-content:flex-end;margin-top:28rpx}.modal-actions button{margin:0;font-size:24rpx;border-radius:10rpx;padding:0 28rpx}.modal-actions .confirm{background:#5b5fe9;color:#fff}.preview-grid{width:100%;height:100%;display:flex;flex-wrap:wrap;gap:8rpx;padding:12rpx;box-sizing:border-box;position:relative}.preview-grid image{width:31%;height:70rpx;border-radius:8rpx}.preview-count{position:absolute;right:16rpx;bottom:14rpx;background:rgba(30,34,57,.75);color:#fff;border-radius:20rpx;padding:6rpx 14rpx;font-size:19rpx}.upload-note{display:block;color:#94a3b8;font-size:19rpx;margin-top:14rpx;line-height:1.5}
