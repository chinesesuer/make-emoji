page{background:#fff}.page{height:100vh;display:flex;flex-direction:column;color:#0f172a;background:#fff}.header{height:164rpx;background:#5b5fe9;color:#fff;flex-shrink:0;padding-top:env(safe-area-inset-top);box-sizing:border-box}.nav{height:100%;padding:40rpx 34rpx 22rpx 30rpx;display:flex;align-items:flex-end;justify-content:space-between;box-sizing:border-box}.back{width:64rpx;height:64rpx;border-radius:50%;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-size:52rpx;line-height:1}.title{font-size:34rpx;font-weight:800}.capsule{height:56rpx;padding:0 18rpx;display:flex;align-items:center;gap:16rpx;background:rgba(255,255,255,.2);border-radius:30rpx;font-size:25rpx}.divider{width:2rpx;height:28rpx;background:rgba(255,255,255,.35)}.circle{width:25rpx;height:25rpx;border:4rpx solid #fff;border-radius:50%}
.content{flex:1;min-height:0}.picker-row{padding:48rpx 42rpx 0;display:flex;align-items:center;justify-content:space-between}.dice{width:64rpx;height:64rpx;border-radius:18rpx;background:#f1f5f9;color:#94a3b8;display:flex;align-items:center;justify-content:center;font-size:36rpx}.emoji-column{width:138rpx;height:384rpx}.column-pad{padding:128rpx 0}.emoji-item{height:128rpx;display:flex;align-items:center;justify-content:center;font-size:66rpx;line-height:1;opacity:.32;transform:scale(.84);transition:opacity .16s,transform .16s}.emoji-item.selected{opacity:1;transform:scale(1.12)}.plus{font-size:60rpx;font-weight:900;line-height:1}.result-wrap{display:flex;justify-content:center;margin-top:28rpx}.result-box{width:450rpx;height:450rpx;position:relative;display:flex;align-items:center;justify-content:center}.probe-image{position:absolute;inset:0;width:100%;height:100%;opacity:0}.probe-image.visible{opacity:1}.fallback{position:absolute;inset:0}.half{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:390rpx;line-height:1}.half-left{clip-path:inset(0 50% 0 0)}.half-right{clip-path:inset(0 0 0 50%)}.loading{display:flex;flex-direction:column;align-items:center;color:#94a3b8;font-size:24rpx}.spinner{width:52rpx;height:52rpx;border:6rpx solid #e2e8f0;border-top-color:#5b5fe9;border-radius:50%;margin-bottom:20rpx;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.actions{display:flex;flex-direction:column;align-items:center;gap:20rpx;margin-top:20rpx}.action{width:240rpx;height:76rpx;line-height:74rpx;padding:0;border-radius:14rpx;background:#fff;font-size:27rpx}.action.save{color:#f43f5e;border:2rpx solid rgba(244,63,94,.55)}.action.share{color:#07c160;border:2rpx solid rgba(7,193,96,.5)}.action::after{border:0}.tip{text-align:center;color:#94a3b8;font-size:22rpx;margin:28rpx 0 50rpx}.export-canvas{position:fixed;left:-1000px;top:-1000px;width:512px;height:512px;pointer-events:none}
