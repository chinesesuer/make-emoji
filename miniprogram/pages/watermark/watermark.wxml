<view class="page">
  <view class="header"><view class="nav"><view class="back" bindtap="goBack">‹</view><text class="title">图片加水印</text><view class="capsule"><text>•••</text><view class="divider"/><view class="circle"/></view></view></view>
  <view class="preview-area">
    <view wx:if="{{!imagePath}}" class="empty-preview" bindtap="chooseImages"><text class="empty-icon">▣</text><text class="empty-title">选择需要加水印的图片</text><text class="empty-tip">支持单图处理，也可将两张证件照合成一张</text><button class="choose-inline">选择图片</button></view>
    <block wx:else><canvas type="2d" id="previewCanvas" class="preview-canvas" style="width:{{previewWidth}}px;height:{{previewHeight}}px" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchEnd"/><text class="preview-hint">拖动图片上的水印可调整位置</text></block>
  </view>
  <view class="tool-tabs"><view class="pick-tab" bindtap="chooseImages">▧</view><view wx:for="{{tabs}}" wx:key="id" class="tab {{activeTab === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="switchTab">{{item.name}}</view></view>
  <view class="panel">
    <view wx:if="{{activeTab === 'text'}}" class="panel-inner"><text class="warning">水印文字最多 15 个字</text><view class="text-line"><input value="{{text}}" maxlength="15" placeholder="输入水印文字" bindinput="inputText"/><button bindtap="confirmText">确定</button></view><view class="slider-row"><text>文字大小</text><slider min="8" max="48" value="{{fontSize}}" activeColor="#59BC73" block-color="#59BC73" bindchanging="changeFontSize" bindchange="changeFontSize"/><text>{{fontSize}}</text></view></view>
    <view wx:elif="{{activeTab === 'style'}}" class="panel-inner"><view class="swatches"><view wx:for="{{colors}}" wx:key="id" class="swatch {{color === item.value ? 'selected' : ''}} {{item.light ? 'light' : ''}}" style="background:{{item.value}}" data-color="{{item.value}}" bindtap="selectColor">{{color === item.value ? '✓' : ''}}</view></view><view class="slider-row"><text>文字透明度</text><slider min="0" max="100" value="{{opacity}}" activeColor="#59BC73" block-color="#59BC73" bindchanging="changeOpacity" bindchange="changeOpacity"/><text>{{opacity}}%</text></view></view>
    <view wx:elif="{{activeTab === 'angle'}}" class="panel-inner centered"><view class="slider-row"><text>文字倾斜</text><slider min="-90" max="90" value="{{angle}}" activeColor="#59BC73" block-color="#59BC73" bindchanging="changeAngle" bindchange="changeAngle"/><text>{{angle}}°</text></view><text class="helper">向右增大角度，向左减小角度</text></view>
    <view wx:elif="{{activeTab === 'density'}}" class="panel-inner"><view class="slider-row"><text>横向间距</text><slider min="28" max="160" value="{{horizontalSpace}}" activeColor="#59BC73" block-color="#59BC73" bindchanging="changeHorizontalSpace" bindchange="changeHorizontalSpace"/><text>{{horizontalSpace}}</text></view><view class="slider-row"><text>纵向间距</text><slider min="28" max="160" value="{{verticalSpace}}" activeColor="#59BC73" block-color="#59BC73" bindchanging="changeVerticalSpace" bindchange="changeVerticalSpace"/><text>{{verticalSpace}}</text></view></view>
    <view wx:else class="panel-inner"><view class="swatches"><view wx:for="{{colors}}" wx:key="id" class="swatch {{maskColor === item.value ? 'selected' : ''}} {{item.light ? 'light' : ''}}" style="background:{{item.value}}" data-color="{{item.value}}" bindtap="selectMaskColor">{{maskColor === item.value ? '✓' : ''}}</view></view><view class="slider-row"><text>蒙板透明度</text><slider min="0" max="70" value="{{maskOpacity}}" activeColor="#59BC73" block-color="#59BC73" bindchanging="changeMaskOpacity" bindchange="changeMaskOpacity"/><text>{{maskOpacity}}%</text></view><text class="helper">设置为 0 即可关闭蒙板</text></view>
  </view>
  <view class="bottom"><button class="secondary" bindtap="chooseImages">重新选择</button><button class="primary" loading="{{saving}}" disabled="{{!imagePath || saving}}" bindtap="saveImage">保存图片</button></view>
  <canvas type="2d" id="exportCanvas" class="export-canvas"/>
</view>
